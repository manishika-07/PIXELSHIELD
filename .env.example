# Photo Shield Backend Configuration
ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000", "http://localhost:3000", "http://localhost:5500", "http://127.0.0.1:5500", "*"]

# Privacy & Security
SECRET_KEY=change_me_photo_shield_secret_key_hmac_2026_pixelshield
EVIDENCE_VAULT_DIR=./data/vault
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB
RATE_LIMIT_PER_MINUTE=60
JOB_TTL_SECONDS=600 # 10 minutes

# ML & Shield Engine
DEVICE=auto # 'cuda', 'cpu', or 'auto'
RESIZE_MAX_LONG_SIDE=1024
DEFAULT_PGD_STEPS=60
DEFAULT_EPSILON=0.03137 # 8/255
FACE_MODEL=vggface2
VAE_MODEL=stabilityai/sd-vae-ft-mse

# Pluggable Watch Providers
DEFAULT_SEARCH_PROVIDER=mock # 'mock', 'google_vision', 'tineye'
GOOGLE_VISION_API_KEY=
TINEYE_API_KEY=
WEBHOOK_ALERT_URL=
